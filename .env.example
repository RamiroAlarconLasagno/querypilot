# .env.example
# Copiar a .env y completar. NUNCA versionar .env.

# --- Base propia del sistema (lectura y escritura) -------------------------
QP_SYSTEM_DB_URL=postgresql+psycopg://querypilot:cambiar@localhost:5432/querypilot

# --- Base de negocio de demostracion (SOLO LECTURA) ------------------------
# Usuario distinto y con permisos distintos: es la barrera real, no un chequeo.
QP_BUSINESS_DB_URL=postgresql+psycopg://qp_readonly:cambiar@localhost:5432/demo_negocio

# --- Proveedor del modelo --------------------------------------------------
# El CI NO tiene esta variable y no debe tenerla.
QP_MODEL_PROVIDER=openai
QP_MODEL_NAME=
OPENAI_API_KEY=

# --- Credencial de la API --------------------------------------------------
QP_API_KEY=cambiar-por-una-clave-larga

# --- Artefacto semantico ---------------------------------------------------
QP_SEMANTIC_DIR=semantic
QP_PROMPTS_DIR=prompts
